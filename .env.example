# JWT issuer claim
JWT_ISSUER="sovgrant"

# Access token lifetime (m = minutes, h = hours, d = days)
JWT_ACCESS_TTL="15m"

# Refresh token lifetime
JWT_REFRESH_TTL="7d"

# RSA/EC key pair paths for RS256/ES256 token signing (optional â€” JWT_SECRET is
# used if these are empty or the files don't exist)
PRIVATE_KEY_PEM="./certs/private.pem"
PUBLIC_KEY_PEM="./certs/public.pem"


{
  "name": "@fusorb/sg-cli",
  "version": "0.1.0",
  "description": "SovGrant CLI — scaffold and audit a sovereign identity/auth backend in any consumer repo.",
  "type": "module",
  "bin": {
    "sg": "./dist/index.js",
    "sovgrant": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "commander": "^12.1.0",
    "execa": "^9.5.0",
    "pg": "^8.23.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  }
}
